const APP = { SHEET: 'Receivables', SETTINGS: 'Settings', LOG: 'Reminder Log' };
const HEADERS = ['ID','Customer / Ledger','Business Unit','Credit Terms (Days)','Document No','Document Date','Due Date','Actual Amount','0-15 Days','15-30 Days','30-60 Days','60-90 Days','90+ Days','Outstanding','Business Head','Business Head Email','Responsible Person','Responsible Email','Last Updated','Remarks'];
function doGet(){ return HtmlService.createHtmlOutputFromFile('Index').setTitle('Receivables Control Centre').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL); }
function setupReceivables(){ const ss=SpreadsheetApp.getActive(); ensureSheet_(ss,APP.SHEET,HEADERS); ensureSheet_(ss,APP.SETTINGS,['Key','Value']); ensureSheet_(ss,APP.LOG,['Timestamp','Recipient','Type','Rows','Result']); const st=ss.getSheetByName(APP.SETTINGS); if(st.getLastRow()===1){st.getRange(2,1,5,2).setValues([['Company Name','MAFARM'],['Reminder Frequency','Daily'],['Reminder Time','09:00'],['Default Business Head Email',''],['Last Import','']]);} return 'Setup completed. Spreadsheet: '+ss.getUrl(); }
function ensureSheet_(ss,name,headers){let sh=ss.getSheetByName(name)||ss.insertSheet(name); if(sh.getLastRow()===0) sh.appendRow(headers); else if(sh.getLastRow()===1 && sh.getRange(1,1).getValue()==='') sh.getRange(1,1,1,headers.length).setValues([headers]); return sh;}
function getAppData(){const ss=SpreadsheetApp.getActive(); if(!ss.getSheetByName(APP.SHEET)) setupReceivables(); const sh=ss.getSheetByName(APP.SHEET), vals=sh.getDataRange().getValues(); return {headers:HEADERS,rows:vals.slice(1).filter(r=>r[0]).map(rowObj_),settings:getSettings_(),spreadsheetUrl:ss.getUrl()};}
function rowObj_(r){let o={};HEADERS.forEach((h,i)=>o[h]=r[i] instanceof Date?Utilities.formatDate(r[i],Session.getScriptTimeZone(),'yyyy-MM-dd'):r[i]);return o;}
function getSettings_(){let sh=SpreadsheetApp.getActive().getSheetByName(APP.SETTINGS);let o={};if(sh&&sh.getLastRow()>1) sh.getRange(2,1,sh.getLastRow()-1,2).getValues().forEach(r=>o[r[0]]=r[1]);return o;}
function saveRecord(obj){const sh=SpreadsheetApp.getActive().getSheetByName(APP.SHEET); const id=String(obj.ID||Utilities.getUuid()); obj.ID=id;if(!obj['Due Date']&&obj['Document Date']&&obj['Credit Terms (Days)']!==''){const d=new Date(obj['Document Date']);if(!isNaN(d.getTime())){d.setDate(d.getDate()+Number(obj['Credit Terms (Days)']));obj['Due Date']=Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd');}} obj['Last Updated']=new Date(); const row=HEADERS.map(h=>obj[h]===undefined?'':obj[h]); const vals=sh.getDataRange().getValues();let at=vals.findIndex((r,i)=>i>0&&String(r[0])===id); if(at<0) sh.appendRow(row); else sh.getRange(at+1,1,1,HEADERS.length).setValues([row]);return {ok:true,id};}
function deleteRecord(id){const sh=SpreadsheetApp.getActive().getSheetByName(APP.SHEET),v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id)){sh.deleteRow(i+1);return true;}return false;}
function importRecords(list,replaceAll){
 let added=0,updated=0,skipped=0,errors=[];
 list.forEach((src,i)=>{try{let n={};Object.keys(src||{}).forEach(k=>{let key=String(k).trim().toLowerCase();let a={'customer name':'Customer / Ledger','customer':'Customer / Ledger','customer / ledger':'Customer / Ledger','department':'Business Unit','business unit':'Business Unit','date':'Document Date','document date':'Document Date','terms':'Credit Terms (Days)','credit terms (days)':'Credit Terms (Days)','bill amount':'Actual Amount','amount':'Actual Amount','actual amount':'Actual Amount','document no':'Document No','docno':'Document No','invoice no':'Document No','invoice number':'Document No','due date':'Due Date','outstanding':'Outstanding','business head':'Business Head','business head email':'Business Head Email','responsible person':'Responsible Person','responsible email':'Responsible Email','remarks':'Remarks'};n[a[key]||k]=src[k]});
 if(!n['Customer / Ledger']||n['Actual Amount']===''||n['Actual Amount']===undefined){skipped++;errors.push({row:i+2,reason:'Customer Name or Bill Amount missing'});return}
 let c=all_(APP.CUSTOMERS,CH).find(x=>String(x['Customer Name']).trim().toLowerCase()===String(n['Customer / Ledger']).trim().toLowerCase());if(c){n['Customer ID']=c['Customer ID'];['Business Unit','Credit Terms (Days)','Business Head','Business Head Email','Responsible Person','Responsible Email'].forEach(k=>{if((n[k]===''||n[k]===undefined||n[k]===null)&&c[k]!==undefined)n[k]=c[k]})}
 let dt=n['Document Date'];if(dt instanceof Date)n['Document Date']=Utilities.formatDate(dt,Session.getScriptTimeZone(),'yyyy-MM-dd');else if(typeof dt==='number'&&dt>0)n['Document Date']=Utilities.formatDate(new Date(Math.round((dt-25569)*86400000)),Session.getScriptTimeZone(),'yyyy-MM-dd');else if(dt){let d=new Date(dt);if(!isNaN(d.getTime()))n['Document Date']=Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd')}
 if(!n['Document No'])n['Document No']='BULK-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+(i+1);if(n['Outstanding']===''||n['Outstanding']===undefined||n['Outstanding']===null)n['Outstanding']=Number(n['Actual Amount']||0);
 if(!n['Due Date']&&n['Document Date']&&n['Credit Terms (Days)']!==''&&n['Credit Terms (Days)']!==undefined){let d=new Date(n['Document Date']+'T12:00:00');if(!isNaN(d.getTime())){d.setDate(d.getDate()+Number(n['Credit Terms (Days)']||0));n['Due Date']=Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd')}}
 let old=all_(APP.SHEET,RH).find(x=>String(x['Document No'])===String(n['Document No']));if(old){n.ID=old.ID;saveReceivable({...old,...n});updated++}else{saveReceivable(n);added++}
 }catch(e){skipped++;errors.push({row:i+2,reason:e.message})}});return {added,updated,skipped,errors};
}
function normalize_(o){const aliases={'ledgerName':'Customer / Ledger','__EMPTY':'Business Unit','Unnamed: 1':'Business Unit','Business Unit':'Business Unit','Terms':'Credit Terms (Days)','DocNo':'Document No','DocDate':'Document Date','Actual':'Actual Amount','0-15':'0-15 Days','15-30':'15-30 Days','30-60':'30-60 Days','60-90':'60-90 Days','Outstanding':'Outstanding','Responsible':'Responsible Person','Responsible Email':'Responsible Email','Business Head':'Business Head','Business Head Email':'Business Head Email','Remarks':'Remarks','Due Date':'Due Date','90+':'90+ Days'};let n={};Object.keys(o||{}).forEach(k=>{let key=aliases[String(k).trim()]||String(k).trim();if(HEADERS.includes(key))n[key]=o[k];});if(!n['Outstanding'])n['Outstanding']=n['Actual Amount']||0;if(!n['Customer / Ledger'])n['Customer / Ledger']='';return n;}
function clearAllData(){const sh=SpreadsheetApp.getActive().getSheetByName(APP.SHEET);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,HEADERS.length).clearContent();return true;}
function saveSettings(obj){const sh=SpreadsheetApp.getActive().getSheetByName(APP.SETTINGS);const v=sh.getDataRange().getValues();Object.keys(obj).forEach(k=>{let found=false;for(let i=1;i<v.length;i++)if(v[i][0]===k){sh.getRange(i+1,2).setValue(obj[k]);found=true;break;}if(!found)sh.appendRow([k,obj[k]]);});return true;}
function sendReminderEmails(){const ss=SpreadsheetApp.getActive(),sh=ss.getSheetByName(APP.SHEET),rows=sh.getDataRange().getValues().slice(1).map(rowObj_).filter(r=>r.ID&&Number(r.Outstanding)>0);let groups={};rows.forEach(r=>{const recipients=[r['Responsible Email'],r['Business Head Email']].filter(Boolean);recipients.forEach(email=>{const key=email+'|'+(email===r['Responsible Email']?'Responsible':'Business Head');groups[key]=groups[key]||[];groups[key].push(r);});});let sent=0,log=ss.getSheetByName(APP.LOG);Object.keys(groups).forEach(k=>{const [email,type]=k.split('|');const list=groups[k];const html='<p>Dear '+(type==='Responsible'?'Responsible Person':'Business Head')+',</p><p>Please review and follow up on the outstanding receivables assigned to you.</p><table border="1" cellpadding="6" cellspacing="0"><tr><th>Customer</th><th>Unit</th><th>Invoice</th><th>Date</th><th>Due Date</th><th>Outstanding</th><th>Ageing</th></tr>'+list.map(r=>'<tr><td>'+esc_(r['Customer / Ledger'])+'</td><td>'+esc_(r['Business Unit'])+'</td><td>'+esc_(r['Document No'])+'</td><td>'+esc_(r['Document Date'])+'</td><td>'+esc_(r['Due Date'])+'</td><td>₹'+Number(r.Outstanding||0).toLocaleString('en-IN')+'</td><td>'+age_(r)+'</td></tr>').join('')+'</table><p><b>Total outstanding: ₹'+list.reduce((s,r)=>s+Number(r.Outstanding||0),0).toLocaleString('en-IN')+'</b></p><p>Kindly update collection status and expected payment date in the Receivables Control Centre.</p><p>Regards,<br>Operations Team<br>MAFARM</p>';try{MailApp.sendEmail({to:email,subject:'Receivables Follow-up | '+type+' | '+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'dd-MMM-yyyy'),htmlBody:html});log.appendRow([new Date(),email,type,list.length,'Sent']);sent++;}catch(e){log.appendRow([new Date(),email,type,list.length,'Failed: '+e.message]);}});return {ok:true,sent:sent,groups:Object.keys(groups).length};}
function age_(r){for(const k of ['90+ Days','60-90 Days','30-60 Days','15-30 Days','0-15 Days'])if(Number(r[k])>0)return k;return 'Current / Not aged';}
function createDailyReminderTrigger(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='sendReminderEmails').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('sendReminderEmails').timeBased().everyDays(1).atHour(9).create();return 'Daily reminder trigger created (approximately 9 AM, script timezone).';}
function esc_(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
